{
  "schemaVersion": 1,
  "id": "{{mod_id}}",
  "version": "${version}",
  "name": "{{display_name}}",
  "description": "{{description}}",
  "authors": ["{{author}}"],
  "license": "{{license}}",
  "environment": "*",
  "entrypoints": {
    "main": ["{{package_name}}.{{ClassName}}"]
  },
  "mixins": ["{{mod_id}}.mixins.json"],
  "depends": {
    "fabricloader": ">={{fabric_loader_version}}",
    "minecraft": "{{mc_version}}",
    "java": ">={{java_version}}",
    "fabric-api": ">={{fabric_api_version}}",
    "geckolib": "{{geckolib_range}}"
  }
}
