{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "minemods",
  "description": "MineMods Studio: 用 AI 帮你做 Minecraft 模组的桌面软件",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "studio": "bun run --cwd packages/studio dev",
    "dev": "bun run studio",
    "lint": "oxlint",
    "typecheck": "bun turbo typecheck",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.3.12",
      "@types/node": "22.13.9",
      "@tsconfig/bun": "1.0.9",
      "@playwright/test": "1.59.1",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "zod": "4.1.8",
      "vite": "7.1.4",
      "solid-js": "1.9.10",
      "vite-plugin-solid": "2.11.10"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "turbo": "2.8.13"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/minemods"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "electron"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "patchedDependencies": {
    "solid-js@1.9.10": "patches/solid-js@1.9.10.patch"
  }
}
